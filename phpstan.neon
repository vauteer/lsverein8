includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Ported verbatim from lsverein7. These subclass the untyped fpdf/fpdf library,
    # so adding native parameter types to the inherited methods would break their
    # signatures. Remove this once the PDF layer is rewritten.
    excludePaths:
        analyseAndScan:
            - app/Pdf
